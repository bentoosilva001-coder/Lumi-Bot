# Copie este arquivo para ".env" (sem o ".example") e cole sua chave real.
# Pegue a sua em: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# FASE 4 — Transcrição de áudio (grátis dentro do limite)
# Crie sua conta gratuita em https://console.groq.com/keys e cole a
# chave aqui. Sem essa chave, o bot ainda funciona normal com texto —
# só avisa que não entende áudio ainda.
GROQ_API_KEY=gsk_sua-chave-aqui

# FASE 5 — Proteção de custo (opcional, já tem um padrão se não mexer)
# Quanto o bot pode gastar em IA por dia, em dólares, antes de passar
# a responder com uma mensagem padrão em vez de chamar a IA de novo.
DAILY_BUDGET_USD=1.00

# Quantas mensagens uma MESMA pessoa pode mandar por hora antes do
# bot pausar as respostas pra ela (protege contra spam/abuso).
MAX_MESSAGES_PER_HOUR=07
